# ==========================================================================
# FinVote 版本控制忽略规则
# ==========================================================================

# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---- Node / 前端 ----
node_modules/
.vite/
dist/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 注意：backend/src/main/resources/static 是前端构建产物，但**故意提交**。
# 原因：这样克隆仓库后执行 `mvn package` 就能直接得到可运行的完整 JAR，
# 不需要先装 Node 再构建前端。构建前端时 Vite 的 emptyOutDir 会自动覆盖它，
# 不会出现新旧文件混杂。若想改为不提交，删掉这条说明并在此加上该目录即可。

# ---- SQLite 数据库与运行数据 ----
data/
*.db
*.db-wal
*.db-shm

# ---- 日志 ----
*.log
logs/

# ---- 备份 ----
backup/

# ---- 环境变量（含密钥与管理员密码，绝不入库） ----
.env
.env.local
.env.*.local

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store
