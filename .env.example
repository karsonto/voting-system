# FinVote 环境变量
# 复制为 .env 后按现场情况修改；docker compose 会自动读取同目录下的 .env

# 令牌签名密钥：正式部署必须替换成随机长字符串，否则他人可伪造管理员令牌
FINVOTE_SECRET=finvote-dev-secret-change-me-in-production

# 首次启动自动创建的管理员账号（仅在数据库中不存在任何管理员时生效）
FINVOTE_ADMIN_USERNAME=admin
FINVOTE_ADMIN_PASSWORD=admin123

# 宿主机映射端口
FINVOTE_PORT=8080

# 数据库文件在容器内的位置。compose 已把它固定为 /app/data/finvote.db，
# 并通过 volumes 映射到宿主机 ./data 目录，通常无需改动。
# FINVOTE_DB_PATH=/app/data/finvote.db
